# ClipScout Engine Configuration ($0 Free Tier)

# Groq Cloud API Key (Required for fast Whisper STT and LLM candidate scoring)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (Optional backup LLM)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# YouTube Data API v3 Key (Optional for searching top videos for hashtag suggestions)
# Get a free key with daily quota at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Engine Server Port (Default: 8787)
ENGINE_PORT=8787

# Data directory for job storage, video cache, and generated clips
ENGINE_DATA_DIR=./.engine_data

# Optional protection token for the engine (Single user mode on 127.0.0.1)
ENGINE_TOKEN=

# Optional browser cookies for yt-dlp to access private/unlisted videos (e.g. chrome, firefox, edge)
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Preferred Groq Model IDs (comma-separated, verified at startup against Groq /v1/models)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

